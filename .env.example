# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────
# Include credentials only in your local .env, never in this file.
MONGODB_URI=mongodb://localhost:27017/e_voting_system

# ── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# ── Blockchain ────────────────────────────────────────
# Local Hardhat: http://127.0.0.1:8545  |  Sepolia: https://sepolia.infura.io/v3/<key>
BLOCKCHAIN_RPC_URL=
CONTRACT_ADDRESS=

# SECRET — backend signer. Must hold RELAYER_ROLE and ELECTION_ADMIN_ROLE on the contract.
# Never commit it, never share it with the frontend.
BACKEND_PRIVATE_KEY=

# Warn when the relayer can no longer fund transactions.
RELAYER_MIN_BALANCE_ETH=0.05
# Confirmations before a receipt counts as final. 1 locally; raise it on a public chain.
CONFIRMATIONS=1

# Global rate limit (the per-route limits on login/registration/voting are tighter).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Auth ──────────────────────────────────────────────
# SECRET — at least 32 characters. Startup refuses the development default in production.
JWT_SECRET=
JWT_EXPIRES_IN=24h
FACIAL_VERIFICATION_MODE=registration_only   # | login_and_registration
MINIMUM_VOTING_AGE=18

# ── Identity providers ────────────────────────────────
# `mock` is refused when NODE_ENV=production.
NID_PROVIDER=mock
NID_PROVIDER_URL=
NID_PROVIDER_KEY=
FACE_PROVIDER=mock
FACE_PROVIDER_URL=
FACE_PROVIDER_KEY=
FACE_MATCH_THRESHOLD=0.85
FACE_LIVENESS_REQUIRED=true

# ── Identity cryptography ─────────────────────────────
# SECRET — the pepper is what keeps a 13-digit National ID un-brute-forceable.
# Changing it orphans every existing duplicate-detection hash.
NID_HMAC_PEPPER=
# SECRET — 32 bytes of hex (64 characters), AES-256-GCM at rest.
PII_ENCRYPTION_KEY=

# ── Election cryptography ─────────────────────────────
# Must be a multiple of 256: the contract requires len(n) % 32 == 0 bytes.
PAILLIER_KEY_BITS=2048
# Base used to pack per-candidate counters into one plaintext.
BALLOT_BASE_BITS=32

# The trustee committee: signing addresses, comma-separated. Each submits its own
# decryption share with its own key — the backend never holds a trustee key or share.
TRUSTEE_ADDRESSES=
