# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────
# Include credentials only in your local .env, never in this file.
MONGODB_URI=mongodb://localhost:27017/e_voting_system

# ── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# ── Blockchain (optional until the contract is deployed) ─
# Local Hardhat: http://127.0.0.1:8545  |  Sepolia: https://sepolia.infura.io/v3/<key> (or Alchemy, etc.)
BLOCKCHAIN_RPC_URL=
CONTRACT_ADDRESS=

# SECRET — backend signer key (0x + 64 hex chars). Never commit, never share with the frontend.
BACKEND_PRIVATE_KEY=
